<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.MenuController"
            prefWidth="1920" prefHeight="1080">

    <VBox spacing="60" alignment="CENTER" prefWidth="1920" prefHeight="1080"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <VBox alignment="CENTER">
            <Label text="Misja Obywatel"
                   style="-fx-font-size: 72px; -fx-font-weight: bold;"/>
            <Label text="Czas wyborów"
                   style="-fx-font-size: 36px; -fx-opacity: 0.8;"/>
        </VBox>
        <VBox spacing="20" alignment="CENTER">
            <Button text="Rozpocznij grę" prefWidth="300" prefHeight="60"
                    style="-fx-font-size: 20px;" fx:id="rozpocznijGreButton"/>
            <Button text="Tabela wyników" prefWidth="300" prefHeight="60"
                    style="-fx-font-size: 20px;" fx:id="tabelaWynikowButton"/>
            <Button text="Wyjście" prefWidth="300" prefHeight="60"
                    style="-fx-font-size: 20px;" fx:id="wyjscieButton"/>
        </VBox>

    </VBox>
</AnchorPane>
